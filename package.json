{
  "name": "fhir-terminology-runtime",
  "version": "1.3.0",
  "description": "Runtime FHIR terminology utilities",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "author": "Outburn Ltd.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run clean && tsup",
    "clean": "rimraf dist",
    "clear:cache": "rimraf test/.test-cache",
    "prepublishOnly": "npm run build",
    "test": "vitest run --coverage",
    "test:hard": "npm run clear:cache && vitest run --coverage"
  },
  "keywords": [
    "fhir",
    "hl7",
    "terminology",
    "valueset",
    "codesystem",
    "expansion",
    "package",
    "conformance",
    "cache",
    "runtime"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Outburn-IL/fhir-terminology-runtime.git"
  },
  "dependencies": {
    "fs-extra": "^11.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@outburn/types": "^0.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/json5": "^2.2.0",
    "@types/range-parser": "^1.2.7",
    "@types/yargs-parser": "^21.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.3",
    "fhir-package-explorer": "^1.9.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  }
}
